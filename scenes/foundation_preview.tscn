[gd_scene load_steps=12 format=3]

; THE PREVIEW BUILD -- everything new, walkable, in one scene.
;
; ⛔ This exists so the classroom game does NOT have to be replaced to look
; at the new art. GitHub Pages serves one site and `deploy.yml` fires only on
; a push to main, so the only way to see this on a URL is to publish it
; ALONGSIDE the game: the real game stays at the site root and this is
; exported a second time into /preview/.
;
; scenes/main.tscn is untouched. Nothing here is wired into the game.
;
; The home field is on the left, the village across the green to the north.
; Chuck can walk from one to the other, which is the whole point -- the two
; sets were built months apart and have to look like one world.

[ext_resource type="PackedScene" path="res://storybook/foundation/terrain.tscn" id="Terrain"]
[ext_resource type="PackedScene" path="res://storybook/foundation/props.tscn" id="Props"]
[ext_resource type="PackedScene" path="res://storybook/foundation/garden.tscn" id="Garden"]
[ext_resource type="PackedScene" path="res://storybook/foundation/cottage.tscn" id="Cottage"]
[ext_resource type="PackedScene" path="res://storybook/foundation/tree.tscn" id="Tree"]
[ext_resource type="PackedScene" path="res://storybook/foundation/block.tscn" id="Block"]
[ext_resource type="PackedScene" path="res://storybook/foundation/chuck.tscn" id="Player"]
[ext_resource type="PackedScene" path="res://village/foundation_village.tscn" id="Village"]
[ext_resource type="Script" path="res://environment/fixed_camera.gd" id="Camera"]
[ext_resource type="PackedScene" path="res://ui/touch_controls.tscn" id="UI"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial"]
sky_top_color = Color(0.62, 0.66, 0.70, 1)
sky_horizon_color = Color(0.80, 0.82, 0.82, 1)
sky_curve = 0.35
ground_bottom_color = Color(0.46, 0.47, 0.45, 1)
ground_horizon_color = Color(0.74, 0.75, 0.73, 1)

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMaterial")

; ⭐ AgX. scenes/main.tscn has no tonemapper at all, so the palette renders
; raw and markedly hotter than every Blender review of the same assets. This
; is the half of the colour pipeline the engine was missing; the sRGB fix in
; storybook_surface.gd is the other half and is still required.
;
; ⛔ OVERCAST, and the saturation adjustment below is NOT optional dressing.
; The note was that the light should be soft -- "a gray day in england"
; rather than golden hour -- and the obvious way to get there is to dim
; everything, which is exactly what bleaches the scene to pastel. AgX
; desaturates as it rolls off, so dimming AND tone mapping both pull chroma
; out at once and the roof stops reading as terracotta. Blender's grade
; solves this with the "Punchy" look; `adjustment_saturation` is the engine's
; equivalent. Dim the light, then put the colour back. Wet grass under cloud
; is if anything GREENER than grass in sun, not greyer.
[sub_resource type="Environment" id="Environment"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 2
ambient_light_color = Color(0.84, 0.86, 0.87, 1)
ambient_light_energy = 0.82
tonemap_mode = 4
tonemap_exposure = 1.02
tonemap_white = 2.0
adjustment_enabled = true
adjustment_saturation = 1.22

[sub_resource type="PlaneMesh" id="GreenMesh"]
size = Vector2(120, 120)

[sub_resource type="StandardMaterial3D" id="GreenMat"]
albedo_color = Color(0.482, 0.604, 0.329, 1)
roughness = 1.0

[node name="FoundationPreview" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment")

[node name="Sun" type="DirectionalLight3D" parent="."]
; ⛔ Nearly overhead and very wide. A grey day has almost no
; direction to its light: the whole sky is the source, so the key
; is dim, 26 degrees across, and its shadows are pale and soft.
transform = Transform3D(0.86602540, -0.25000000, 0.43301270, 0, 0.86602540, 0.50000000, -0.50000000, -0.43301270, 0.75000000, 0, 11, 0)
light_color = Color(0.96, 0.97, 1, 1)
light_energy = 0.40
light_angular_distance = 26.0
shadow_enabled = true
shadow_opacity = 0.34
shadow_blur = 4.0

; The ground the village green sits on. The village scene carries collision
; but no ground MESH -- in the real game the Environment supplies that.
; ⛔ It must sit BELOW the terrain's lowest point, not at 0. The play area
; is dead flat now, but the terrain still falls away past r=9 m on its way
; up into the far hills, and a plane at 0 punched through every hollow out
; there and speckled the field with pale mint patches. -0.06 clears it. The
; plane exists only to carry the village green beyond the 26 m the sculpted
; terrain covers.
[node name="Green" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.06, -16)
mesh = SubResource("GreenMesh")
surface_material_override/0 = SubResource("GreenMat")

