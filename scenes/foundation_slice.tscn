[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial"]
sky_top_color = Color(0.62, 0.66, 0.70, 1)
sky_horizon_color = Color(0.80, 0.82, 0.82, 1)
sky_curve = 0.35
ground_bottom_color = Color(0.46, 0.47, 0.45, 1)
ground_horizon_color = Color(0.74, 0.75, 0.73, 1)

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMaterial")

[sub_resource type="Environment" id="Environment"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 2
ambient_light_color = Color(0.84, 0.86, 0.87, 1)
ambient_light_energy = 0.82
; ⭐ AGX TONE MAPPING (mode 4). scenes/main.tscn has no tonemapper at all, so
; the engine writes linear light straight out and the palette renders RAW:
; the first in-engine export of this slice came out markedly more saturated
; than every Blender review of the same assets -- a red roof where the review
; had terracotta, and a vivid meadow where the review had sage.
;
; ⛔ That was NOT a colour-management bug, and it was worth proving rather
; than assuming. Exporting the same slice with `albedo_texture_force_srgb`
; DISABLED produced the opposite failure exactly as PROGRESS describes it --
; washed out, pale, plaster clipping to white. So the sRGB fix is right and
; still needed; what was missing is the tonemapper, which is the other half
; of what AgX was doing in `render_foundation.py`.
;
; This is a DEVIATION from the shipping environment and a decision to make
; deliberately: adopting these assets means adopting a tonemapper with them,
; or re-grading the whole palette for linear output.
tonemap_mode = 4
tonemap_exposure = 1.02
tonemap_white = 2.0
adjustment_enabled = true
adjustment_saturation = 1.22

[node name="FoundationSlice" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment")

; Matching the Blender review rig as closely as the engine allows. The study
; rig's 5-degree sun is a point light in all but name, and hard shadows were
; the note that started this.
[node name="Sun" type="DirectionalLight3D" parent="."]
; ⛔ Nearly overhead and very wide. A grey day has almost no
; direction to its light: the whole sky is the source, so the key
; is dim, 26 degrees across, and its shadows are pale and soft.
transform = Transform3D(0.86602540, -0.25000000, 0.43301270, 0, 0.86602540, 0.50000000, -0.50000000, -0.43301270, 0.75000000, 0, 11, 0)
light_color = Color(0.96, 0.97, 1, 1)
light_energy = 0.40
light_angular_distance = 26.0
shadow_enabled = true
shadow_opacity = 0.34
shadow_blur = 4.0

