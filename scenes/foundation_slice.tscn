[gd_scene load_steps=12 format=3]

; THE FOUNDATION SLICE -- the approved set, walkable, in the real engine.
;
; Phase 2's first milestone: everything that was a Blender render is now a
; Godot scene. Chuck is RIGGED and is the avatar rather than a display model,
; the terrain has real collision and is not flat, and the blocks are live
; AlphabetBlocks so their letters are generated at runtime.
;
; Nothing here is wired into the game. scenes/main.tscn is untouched.
;
; ⛔ Every object's Y is the TERRAIN HEIGHT at its own x,z, computed from the
; same `foundation.terrain_height()` that shaped the mesh -- not 0. The play
; area rolls about 0.35 m, so an object placed at y = 0 either floats or sinks
; by up to 20 cm, which is most of what "the objects look dropped onto the
; surface" means.

[ext_resource type="PackedScene" path="res://storybook/foundation/terrain.tscn" id="Terrain"]
[ext_resource type="PackedScene" path="res://storybook/foundation/props.tscn" id="Props"]
[ext_resource type="PackedScene" path="res://storybook/foundation/garden.tscn" id="Garden"]
