[gd_scene load_steps=7 format=3]

; A BLOCK TEST, not a slice. One job: prove that the foundation block renders
; its letters in the real engine, in the real web export, in a real browser.
;
; `tests/capture.gd` hangs on this machine -- `await
; RenderingServer.frame_post_draw` never fires and viewport readback comes
; back blank -- so the project's documented capture workflow cannot answer
; this. The export-and-look path can.
;
; The letters spell f g y p a j on purpose: f has the tallest ascender in the
; face, g j p y are every descender there is. If the lettering is clipping the
; plaque top or hanging onto the wooden frame, these six show it.

[ext_resource type="PackedScene" path="res://storybook/foundation/block.tscn" id="Block"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial"]
sky_top_color = Color(0.47, 0.67, 0.76, 1)
sky_horizon_color = Color(0.84, 0.86, 0.75, 1)
sky_curve = 0.12
ground_bottom_color = Color(0.3, 0.26, 0.28, 1)
ground_horizon_color = Color(0.84, 0.58, 0.4, 1)

[sub_resource type="Sky" id="Sky"]
