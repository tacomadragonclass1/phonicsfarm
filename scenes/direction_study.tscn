[gd_scene load_steps=20 format=3]

; DIRECTION STUDY -- three visual treatments of the same four subjects
;
; Walk between them. The camera is the SHIPPING one -- environment/fixed_camera.gd
; at pitch 30 / yaw 30 / zoom 9 -- so each direction is judged at the size and
; angle a child actually sees, not at a beauty-render distance.
;
; Left to right: d1 handcrafted sculpted miniature, d2 dimensional painted
; storybook, d3 expressive sculptural contemporary. Groups are 13 units apart
; along the SCREEN-horizontal axis, so walking right moves cleanly from one
; world to the next.
;
; The blocks are live AlphabetBlock instances running the real script, so the
; Label3D letters are generated at runtime exactly as in the game. Everything
; else is a static display model: these are direction studies, and rigging
; three characters before one of them is chosen would be wasted work.
;
; The walking avatar is the PHASE 1 Chuck, because he is the one that is
; already rigged. Each direction's own Chuck stands in its group as a subject.
; Nothing in this scene is wired into the game.

[ext_resource type="PackedScene" path="res://storybook/explore/d1_cottage.tscn" id="d1_cottage"]
[ext_resource type="PackedScene" path="res://storybook/explore/d1_tree.tscn" id="d1_tree"]
[ext_resource type="PackedScene" path="res://storybook/explore/d1_chuck.tscn" id="d1_chuck"]
[ext_resource type="PackedScene" path="res://storybook/explore/d1_block.tscn" id="d1_block"]
[ext_resource type="PackedScene" path="res://storybook/explore/d2_cottage.tscn" id="d2_cottage"]
[ext_resource type="PackedScene" path="res://storybook/explore/d2_tree.tscn" id="d2_tree"]
