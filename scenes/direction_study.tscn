[sub_resource type="Environment" id="Environment"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 2
ambient_light_color = Color(0.82, 0.87, 0.94, 1)
ambient_light_energy = 0.28
reflected_light_source = 0
tonemap_mode = 2
tonemap_white = 1.15

[sub_resource type="StandardMaterial3D" id="GroundMat"]
; LINEAR values, not the sRGB ones the palette is written in. Measured in the
; browser: a plain StandardMaterial3D given sRGB numbers renders exactly as
; washed out as an unfixed GLB texture does, so albedo_color is consumed as
; linear here just like the imported textures are. sRGB #8FA06A -> linear.
albedo_color = Color(0.272, 0.352, 0.152, 1)
roughness = 1.0

[sub_resource type="BoxMesh" id="GroundMesh"]
material = SubResource("GroundMat")
size = Vector3(70, 0.4, 40)

[sub_resource type="BoxShape3D" id="GroundShape"]
