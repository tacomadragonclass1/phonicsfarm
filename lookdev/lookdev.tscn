[node name="Tree" parent="." instance=ExtResource("Tree")]
transform = Transform3D(0.91354546, 0, 0.40673664, 0, 1, 0, -0.40673664, 0, 0.91354546, 3.95, 0, -0.75)

; ⛔ FOUR BLOCKS, SPREAD IN DEPTH, and this is a gameplay instrument rather
; than set dressing. The whole game is a child reading letters laid out on the
; ground, and `tests/village.gd` enforces a no-hidden-letter rule against the
; fixed camera. Any camera change has to be judged on whether the letters
; still read -- so there have to be letters at a near, a middle and a far
; distance to judge it on.
[node name="Block" parent="." instance=ExtResource("Block")]
transform = Transform3D(0.91354546, 0, 0.40673664, 0, 1, 0, -0.40673664, 0, 0.91354546, 0.3, 0, 1.1)
letter = "a"

[node name="BlockC" parent="." instance=ExtResource("Block")]
transform = Transform3D(0.98480775, 0, -0.17364818, 0, 1, 0, 0.17364818, 0, 0.98480775, -1.9, 0, 2.6)
letter = "c"

[node name="BlockT" parent="." instance=ExtResource("Block")]
transform = Transform3D(0.86602540, 0, 0.50000000, 0, 1, 0, -0.50000000, 0, 0.86602540, 2.6, 0, -0.4)
letter = "t"

[node name="BlockS" parent="." instance=ExtResource("Block")]
transform = Transform3D(0.93969262, 0, -0.34202014, 0, 1, 0, 0.34202014, 0, 0.93969262, 5.6, 0, -4.2)
letter = "s"

[node name="Camera3D" type="Camera3D" parent="."]
