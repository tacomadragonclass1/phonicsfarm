[gd_scene load_steps=8 format=3]

; THE LOOK-DEV SCENE. Deliberately four objects: a cottage, a tree, a block
; and a patch of ground.
;
; ⛔ IT IS SMALL ON PURPOSE, and that is a process decision, not a shortcut.
; The last pass drifted from art direction into level design because the only
; place to look at the art was a whole walkable world, and once you are
; looking at a world you start moving buildings. Four objects cannot tempt
; anybody into a layout.
;
; Everything here is instanced from the SHIPPING storybook scenes, at the same
; transforms the preview uses, so the ground pad under the cottage lines up and
; nothing is a special case built to flatter the test.
;
; Variants are applied by lookdev/shoot.gd, not stored here.

[ext_resource type="PackedScene" path="res://storybook/foundation/terrain.tscn" id="Terrain"]
[ext_resource type="PackedScene" path="res://storybook/foundation/cottage.tscn" id="Cottage"]
[ext_resource type="PackedScene" path="res://storybook/foundation/tree.tscn" id="Tree"]
[ext_resource type="PackedScene" path="res://storybook/foundation/block.tscn" id="Block"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial"]
sky_top_color = Color(0.62, 0.66, 0.70, 1)
sky_horizon_color = Color(0.80, 0.82, 0.82, 1)
sky_curve = 0.35
ground_bottom_color = Color(0.46, 0.47, 0.45, 1)
ground_horizon_color = Color(0.74, 0.75, 0.73, 1)

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMaterial")

; The CURRENT grade, copied from scenes/foundation_preview.tscn unchanged, so
; variant "base" really is what is published today and not a reconstruction.
[sub_resource type="Environment" id="Environment"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 2
ambient_light_color = Color(0.84, 0.86, 0.87, 1)
ambient_light_energy = 0.82
tonemap_mode = 4
tonemap_exposure = 1.02
tonemap_white = 2.0
adjustment_enabled = true
adjustment_saturation = 1.22

[node name="LookDev" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.86602540, -0.25000000, 0.43301270, 0, 0.86602540, 0.50000000, -0.50000000, -0.43301270, 0.75000000, 0, 11, 0)
light_color = Color(0.96, 0.97, 1, 1)
light_energy = 0.40
light_angular_distance = 26.0
shadow_enabled = true
shadow_opacity = 0.34
shadow_blur = 4.0

[node name="Terrain" parent="." instance=ExtResource("Terrain")]

[node name="Cottage" parent="." instance=ExtResource("Cottage")]
