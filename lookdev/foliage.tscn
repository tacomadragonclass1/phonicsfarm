[gd_scene load_steps=11 format=3]

; THE FOLIAGE SET, side by side under the chosen look.
;
; ⛔ The point is JUDGING THEM TOGETHER. Each of these was built and approved
; on its own, months apart, and the ink outline is the first thing that has
; ever made their construction comparable: a blob and a carried clump look
; the same under flat shading and completely different under a line.
;
; Left to right: the foundation tree (rebuilt), tree_b (rebuilt), bush,
; blossom, mushrooms. Spacing is even so nothing overlaps and every
; silhouette is read against sky.

[ext_resource type="PackedScene" path="res://storybook/foundation/terrain.tscn" id="Terrain"]
[ext_resource type="PackedScene" path="res://storybook/foundation/tree.tscn" id="Tree"]
[ext_resource type="PackedScene" path="res://storybook/village/tree_b.tscn" id="TreeB"]
[ext_resource type="PackedScene" path="res://storybook/village/bush.tscn" id="Bush"]
[ext_resource type="PackedScene" path="res://storybook/village/blossom.tscn" id="Blossom"]
[ext_resource type="PackedScene" path="res://storybook/village/mushrooms.tscn" id="Mushrooms"]
[ext_resource type="PackedScene" path="res://storybook/foundation/block.tscn" id="Block"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial"]
sky_top_color = Color(0.62, 0.66, 0.70, 1)
sky_horizon_color = Color(0.80, 0.82, 0.82, 1)
