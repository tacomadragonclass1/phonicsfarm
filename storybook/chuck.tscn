[gd_scene load_steps=5 format=3]

; Painted Storybook Chuck.
;
; A drop-in replacement for player/player.tscn. The SCRIPT, the collision
; capsule and the CarryAnchor are copied across unchanged, because player.gd
; depends on all three: it finds an AnimationPlayer under Visual/Model and
; plays "idle"/"walk" by name, it rotates Visual assuming the model faces
; local +Z, and it parents carried blocks to Visual/CarryAnchor.
;
; The one difference is scale. The Kenney model was 0.671 units tall and had
; to be scaled 1.8x in the scene; chuck.glb is authored at its final 1.18 m,
; so it sits at scale 1 and the capsule still fits.

[ext_resource type="Script" path="res://player/player.gd" id="1"]
[ext_resource type="PackedScene" path="res://assets/storybook/chuck.glb" id="2"]
[ext_resource type="Script" path="res://storybook/storybook_surface.gd" id="Surface"]

[sub_resource type="CapsuleShape3D" id="Capsule"]
radius = 0.3
height = 1.16

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 13
floor_snap_length = 0.2
script = ExtResource("1")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.58, 0)
shape = SubResource("Capsule")

[node name="Visual" type="Node3D" parent="."]

[node name="Model" parent="Visual" instance=ExtResource("2")]

[node name="CarryAnchor" type="Marker3D" parent="Visual"]
position = Vector3(0, 0.8, 0.62)

[node name="SurfaceFix" type="Node" parent="."]
script = ExtResource("Surface")
