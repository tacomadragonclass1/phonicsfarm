[gd_scene load_steps=3 format=3]

; CVC LAND -- the river's water. Instance the GLB and carry its own sRGB
; correction, exactly like every other asset in this set.
;
; ⛔ NOT environment/river.tscn. That one is the OLD Kenney river from the
; shipping classroom game, it is still in use there, and the two have nothing
; to do with each other. Same word, different world.
;
; ⛔ NO COLLISION HERE ON PURPOSE. The river is made uncrossable by an
; invisible wall along its north lip, generated by tools/build_cvc_land.py,
; because a barrier that depends on water being solid breaks the moment
; anybody adjusts the character controller. Water you can stand on is worse
; than water you can walk through; the wall means Chuck reaches neither.

[ext_resource type="PackedScene" path="res://assets/storybook/cvc/river.glb" id="1"]
[ext_resource type="Script" path="res://storybook/storybook_surface.gd" id="2"]

[node name="river" type="Node3D"]

[node name="Model" parent="." instance=ExtResource("1")]

[node name="SurfaceFix" type="Node" parent="."]
script = ExtResource("2")
