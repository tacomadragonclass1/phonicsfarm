[gd_scene load_steps=7 format=3]

; CVC LAND's pedestal: a sawn stump.
;
; ⛔ THE SCRIPT CONTRACT IS UNCHANGED. `pedestal.gd` reads `$Base` and `$Top`
; on ready and animates them to lift a placed letter -- Base is scaled in Y
; and Top rides up on it -- and reparents the block to `$SnapPoint`. Group
; "pedestals", layer 8, mask 2. All of that is carried across exactly; only
; the geometry is new.
;
; ⭐ Base and Top are separate instances for that reason, and a stump is the
; one form where the stretch is free: a taller stump is still a stump.

[ext_resource type="Script" path="res://pedestal/pedestal.gd" id="1"]
[ext_resource type="PackedScene" path="res://assets/storybook/cvc/pedestal_post.glb" id="2"]
[ext_resource type="PackedScene" path="res://assets/storybook/cvc/pedestal_cap.glb" id="3"]
[ext_resource type="Script" path="res://storybook/storybook_surface.gd" id="4"]

[sub_resource type="CylinderShape3D" id="Shape"]
radius = 0.66
height = 0.62

[node name="Pedestal" type="StaticBody3D" groups=["pedestals"]]
collision_layer = 8
collision_mask = 2
script = ExtResource("1")

[node name="Base" parent="." instance=ExtResource("2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.25, 0)

[node name="Top" parent="." instance=ExtResource("3")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.56, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.31, 0)
shape = SubResource("Shape")

[node name="SnapPoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.62, 0)

[node name="SurfaceFix" type="Node" parent="."]
script = ExtResource("4")
