[gd_scene load_steps=5 format=3]

; Painted Storybook pedestal.
;
; Reuses pedestal/pedestal.gd unchanged, which is why the visual arrives as
; two GLBs rather than one. When a letter sounds, that script raises the
; pedestal by stretching $Base (scale.y = 1 + lift/0.5, node moved up by
; lift/2) and translating $Top. The arithmetic only works if Base is exactly
; 0.5 m tall with its origin at its own centre -- which is what
; pedestal_base.glb is -- and the cap has to be a separate node or it would be
; stretched too, every time a block was played.
;
; SnapPoint stays at 0.62: a block's origin is its bottom face, so a block
; placed here rests exactly on the cap. Physics bodies and SnapPoint never
; move during the lift, so Chuck can always take the block back.

[ext_resource type="Script" path="res://pedestal/pedestal.gd" id="1"]
[ext_resource type="PackedScene" path="res://assets/storybook/pedestal_base.glb" id="2"]
[ext_resource type="PackedScene" path="res://assets/storybook/pedestal_top.glb" id="3"]
[ext_resource type="Script" path="res://storybook/storybook_surface.gd" id="Surface"]

[sub_resource type="CylinderShape3D" id="Shape"]
radius = 0.66
height = 0.62

[node name="Pedestal" type="StaticBody3D" groups=["pedestals"]]
collision_layer = 8
collision_mask = 2
script = ExtResource("1")

[node name="Base" parent="." instance=ExtResource("2")]
position = Vector3(0, 0.25, 0)

[node name="Top" parent="." instance=ExtResource("3")]
position = Vector3(0, 0.5, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.31, 0)
shape = SubResource("Shape")

[node name="SnapPoint" type="Marker3D" parent="."]
position = Vector3(0, 0.62, 0)

[node name="SurfaceFix" type="Node" parent="."]
script = ExtResource("Surface")
