[gd_scene load_steps=3 format=3]

; The slice's ground patch. Scoped to the vertical slice -- the live game's
; ground is environment/meadow.gdshader and is untouched.
;
; Wrapped in a scene rather than instanced raw so it carries SurfaceFix with
; it. The first slice build instanced meadow.glb directly and the meadow was
; the one surface still rendering a gamma too bright while everything around
; it was correct.

[ext_resource type="PackedScene" path="res://assets/storybook/meadow.glb" id="1"]
[ext_resource type="Script" path="res://storybook/storybook_surface.gd" id="2"]

[node name="Meadow" type="Node3D"]

[node name="Model" parent="." instance=ExtResource("1")]

[node name="SurfaceFix" type="Node" parent="."]
script = ExtResource("2")
